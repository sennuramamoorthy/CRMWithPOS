# Copy to .env.prod (gitignored) before running `make deploy-up`.

# --- Image registry / tag (used by docker-compose.prod.yml) ---
REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# --- Postgres ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=replace-me-strong-password
POSTGRES_DB=crm

# --- Backend ---
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_MINUTES=720
CORS_ORIGINS=https://app.example.com

# --- Ports exposed on the host ---
BACKEND_PORT=8000
FRONTEND_PORT=80
